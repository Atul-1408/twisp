# TWISP Studio — Environment Variables Example
# Copy this file to .env.local for local development

# ----------------------------------------------------
# Frontend Client Configuration (Vite)
# Safe for browser exposure (public anon key)
# ----------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------
# Server-Side Only Configuration (Vercel API / Serverless)
# NEVER expose these in frontend code or client bundles!
# ----------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Email notifications (Resend API)
RESEND_API_KEY=re_123456789abcdef
ADMIN_EMAIL=twispstudio@gmail.com
